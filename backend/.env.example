# ==============================================================================
# Ticketflow Backend Environment Configuration Template
# ==============================================================================

NODE_ENV=production
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
DISABLE_RATE_LIMIT=false

# Supabase PostgreSQL Connection Pooler (Transaction Mode)
DATABASE_URL=postgresql://ticketflow_app.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=ticketflow_app.<project-ref>
DB_PASSWORD=your_secure_db_password
DB_SSL=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000

# Supabase Platform & Storage SDK
SUPABASE_PROJECT_ID=your_supabase_project_ref
SUPABASE_URL=https://your_supabase_project_ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cryptographic Authentication Secrets (Dual-Token JWT)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_at_least_32_characters
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_at_least_32_characters

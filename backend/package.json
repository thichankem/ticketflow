{
  "name": "ticketflow-backend",
  "version": "1.0.0",
  "description": "Hi.Events clone Node.js Express serverless backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node database/migrations/run-migrations.js",

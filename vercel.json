{
  "version": 2,
  "outputDirectory": "frontend/dist",
  "crons": [
    {
      "path": "/api/cron/reconcile-refunds",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
